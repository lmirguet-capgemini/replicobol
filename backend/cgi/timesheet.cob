>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. timesheet.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT PROJECT-FILE ASSIGN TO DYNAMIC PROJECT-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS PROJECT-STATUS.
    SELECT ENTRY-FILE ASSIGN TO DYNAMIC ENTRY-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS ENTRY-STATUS.
    SELECT CORRECTION-FILE ASSIGN TO DYNAMIC CORRECTION-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS CORRECTION-STATUS.

DATA DIVISION.
FILE SECTION.
FD PROJECT-FILE.
01 PROJECT-LINE PIC X(512).
FD ENTRY-FILE.
01 ENTRY-LINE PIC X(512).
FD CORRECTION-FILE.
01 CORRECTION-LINE PIC X(512).

WORKING-STORAGE SECTION.
01 PROJECT-PATH PIC X(64) VALUE "data/projects.dat".
01 ENTRY-PATH PIC X(64) VALUE "data/weekly-entries.dat".
01 CORRECTION-PATH PIC X(64) VALUE "data/weekly-entry-corrections.dat".
01 PROJECT-STATUS PIC XX.
01 ENTRY-STATUS PIC XX.
01 CORRECTION-STATUS PIC XX.
01 REQUEST-METHOD PIC X(8).
01 FORM-DATA PIC X(2048).
01 PARAM-PAIR.
   05 PARAM-PART OCCURS 8 TIMES PIC X(256).
01 IDX PIC 9(4) VALUE 1.
01 EOF-FLAG PIC X VALUE "N".
01 PROJECT-FOUND PIC X VALUE "N".
01 VALID-FLAG PIC X VALUE "Y".
01 EXISTING-IDX PIC 9(4) VALUE 0.
01 ENTRY-COUNT PIC 9(4) VALUE 0.
01 CORRECTION-RECORDED PIC X VALUE "N".
01 PROJECT-CODE PIC X(64).
01 WEEK-START PIC X(16).
01 DAYS-TEXT PIC X(32).
01 CLEAN-TEXT PIC X(32).
01 ROW-CODE PIC X(64).
01 ROW-CLIENT PIC X(120).
01 ROW-NAME PIC X(120).
01 ROW-CREATED PIC X(32).
01 DAYS-NUM PIC S9(4)V99 VALUE 0.
01 DAYS-X4 PIC S9(4)V99 VALUE 0.
01 DAYS-Q PIC S9(4) VALUE 0.
01 ENTRY-Q PIC S9(4) VALUE 0.
01 TOTAL-Q PIC S9(4) VALUE 0.
01 TOTAL-WHOLE PIC 9(2) VALUE 0.
01 TOTAL-WHOLE-TEXT PIC Z9.
01 TOTAL-REMAINDER PIC 9 VALUE 0.
01 YEAR-NUM PIC 9(4) VALUE 0.
01 MONTH-NUM PIC 9(2) VALUE 0.
01 DAY-NUM PIC 9(2) VALUE 0.
01 YEAR-CALC PIC 9(4) VALUE 0.
01 MONTH-CALC PIC 9(2) VALUE 0.
01 K-VALUE PIC 9(4) VALUE 0.
01 J-VALUE PIC 9(4) VALUE 0.
01 H-VALUE PIC 9(4) VALUE 0.
01 TODAY-VALUE PIC X(21).
01 ENTRY-TABLE.
   05 ENTRY-ROW OCCURS 500 TIMES.
      10 ENTRY-CODE PIC X(64).
      10 ENTRY-WEEK PIC X(16).
      10 ENTRY-DAYS PIC X(32).
      10 ENTRY-UPDATED PIC X(32).

PROCEDURE DIVISION.
MAIN-PROCEDURE.
    ACCEPT REQUEST-METHOD FROM ENVIRONMENT "REQUEST_METHOD"
    IF REQUEST-METHOD = SPACES
        MOVE "POST" TO REQUEST-METHOD
    END-IF

    DISPLAY "Content-Type: application/json"
    DISPLAY ""

    IF FUNCTION TRIM(REQUEST-METHOD) NOT = "POST"
        PERFORM SEND-METHOD-ERROR
        STOP RUN
    END-IF

    ACCEPT FORM-DATA
    PERFORM PARSE-FORM
    PERFORM VALIDATE-INPUTS
    IF VALID-FLAG = "Y"
        PERFORM LOAD-ENTRIES
        COMPUTE TOTAL-Q = TOTAL-Q + DAYS-Q
        IF TOTAL-Q > 20
            PERFORM SEND-TOTAL-ERROR
        ELSE
            PERFORM SAVE-ENTRY
            PERFORM SEND-SUCCESS
        END-IF
    END-IF
    STOP RUN.

PARSE-FORM.
    MOVE SPACES TO PROJECT-CODE WEEK-START DAYS-TEXT PARAM-PAIR
    UNSTRING FORM-DATA DELIMITED BY "&"
        INTO PARAM-PART(1) PARAM-PART(2) PARAM-PART(3) PARAM-PART(4)
             PARAM-PART(5) PARAM-PART(6) PARAM-PART(7) PARAM-PART(8)
    END-UNSTRING
    PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > 8
        IF PARAM-PART(IDX)(1:13) = "project_code="
            MOVE PARAM-PART(IDX)(14:) TO PROJECT-CODE
        END-IF
        IF PARAM-PART(IDX)(1:11) = "week_start="
            MOVE PARAM-PART(IDX)(12:) TO WEEK-START
        END-IF
        IF PARAM-PART(IDX)(1:5) = "days="
            MOVE PARAM-PART(IDX)(6:) TO DAYS-TEXT
        END-IF
    END-PERFORM
    INSPECT PROJECT-CODE REPLACING ALL "+" BY " "
    INSPECT WEEK-START REPLACING ALL "+" BY " "
    INSPECT DAYS-TEXT REPLACING ALL "+" BY " ".

VALIDATE-INPUTS.
    MOVE "Y" TO VALID-FLAG
    IF FUNCTION TRIM(PROJECT-CODE) = ""
        MOVE "N" TO VALID-FLAG
        PERFORM SEND-PROJECT-CODE-ERROR
        EXIT PARAGRAPH
    END-IF
    PERFORM CHECK-PROJECT
    IF PROJECT-FOUND = "N"
        MOVE "N" TO VALID-FLAG
        PERFORM SEND-UNKNOWN-PROJECT-ERROR
        EXIT PARAGRAPH
    END-IF
    PERFORM VALIDATE-WEEK
    IF VALID-FLAG = "N"
        EXIT PARAGRAPH
    END-IF
    PERFORM VALIDATE-DAYS.

CHECK-PROJECT.
    MOVE "N" TO PROJECT-FOUND EOF-FLAG
    OPEN INPUT PROJECT-FILE
    PERFORM UNTIL EOF-FLAG = "Y"
        READ PROJECT-FILE
            AT END MOVE "Y" TO EOF-FLAG
            NOT AT END
                IF PROJECT-LINE(1:1) NOT = "#" AND FUNCTION TRIM(PROJECT-LINE) NOT = ""
                    MOVE SPACES TO ROW-CODE ROW-CLIENT ROW-NAME ROW-CREATED
                    UNSTRING PROJECT-LINE DELIMITED BY "|"
                        INTO ROW-CODE ROW-CLIENT ROW-NAME ROW-CREATED
                    END-UNSTRING
                    IF FUNCTION TRIM(ROW-CODE) = FUNCTION TRIM(PROJECT-CODE)
                        MOVE "Y" TO PROJECT-FOUND EOF-FLAG
                    END-IF
                END-IF
        END-READ
    END-PERFORM
    CLOSE PROJECT-FILE.

VALIDATE-WEEK.
    IF FUNCTION LENGTH(FUNCTION TRIM(WEEK-START)) NOT = 10
        MOVE "N" TO VALID-FLAG
        PERFORM SEND-WEEK-ERROR
        EXIT PARAGRAPH
    END-IF
    IF WEEK-START(5:1) NOT = "-" OR WEEK-START(8:1) NOT = "-"
        MOVE "N" TO VALID-FLAG
        PERFORM SEND-WEEK-ERROR
        EXIT PARAGRAPH
    END-IF
    MOVE WEEK-START TO CLEAN-TEXT
    INSPECT CLEAN-TEXT REPLACING ALL "0" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "1" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "2" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "3" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "4" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "5" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "6" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "7" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "8" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "9" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "-" BY " "
    IF FUNCTION TRIM(CLEAN-TEXT) NOT = ""
        MOVE "N" TO VALID-FLAG
        PERFORM SEND-WEEK-ERROR
        EXIT PARAGRAPH
    END-IF
    COMPUTE YEAR-NUM = FUNCTION NUMVAL(WEEK-START(1:4))
    COMPUTE MONTH-NUM = FUNCTION NUMVAL(WEEK-START(6:2))
    COMPUTE DAY-NUM = FUNCTION NUMVAL(WEEK-START(9:2))
    IF MONTH-NUM < 1 OR MONTH-NUM > 12 OR DAY-NUM < 1 OR DAY-NUM > 31
        MOVE "N" TO VALID-FLAG
        PERFORM SEND-WEEK-ERROR
        EXIT PARAGRAPH
    END-IF
    IF MONTH-NUM < 3
        COMPUTE MONTH-CALC = MONTH-NUM + 12
        COMPUTE YEAR-CALC = YEAR-NUM - 1
    ELSE
        MOVE MONTH-NUM TO MONTH-CALC
        MOVE YEAR-NUM TO YEAR-CALC
    END-IF
    COMPUTE K-VALUE = FUNCTION MOD(YEAR-CALC, 100)
    COMPUTE J-VALUE = FUNCTION INTEGER(YEAR-CALC / 100)
    COMPUTE H-VALUE = FUNCTION MOD(DAY-NUM + FUNCTION INTEGER((13 * (MONTH-CALC + 1)) / 5) + K-VALUE + FUNCTION INTEGER(K-VALUE / 4) + FUNCTION INTEGER(J-VALUE / 4) + (5 * J-VALUE), 7)
    IF H-VALUE NOT = 2
        MOVE "N" TO VALID-FLAG
        PERFORM SEND-WEEK-ERROR
    END-IF.

VALIDATE-DAYS.
    IF FUNCTION TRIM(DAYS-TEXT) = ""
        MOVE "N" TO VALID-FLAG
        PERFORM SEND-DAYS-ERROR
        EXIT PARAGRAPH
    END-IF
    MOVE DAYS-TEXT TO CLEAN-TEXT
    INSPECT CLEAN-TEXT REPLACING ALL "0" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "1" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "2" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "3" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "4" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "5" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "6" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "7" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "8" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "9" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "." BY " "
    IF FUNCTION TRIM(CLEAN-TEXT) NOT = ""
        MOVE "N" TO VALID-FLAG
        PERFORM SEND-DAYS-ERROR
        EXIT PARAGRAPH
    END-IF
    COMPUTE DAYS-NUM = FUNCTION NUMVAL(DAYS-TEXT)
    COMPUTE DAYS-X4 = DAYS-NUM * 4
    COMPUTE DAYS-Q = DAYS-X4
    IF DAYS-NUM < 0 OR DAYS-NUM > 5 OR DAYS-X4 NOT = DAYS-Q
        MOVE "N" TO VALID-FLAG
        PERFORM SEND-DAYS-ERROR
    END-IF.

LOAD-ENTRIES.
    MOVE 0 TO ENTRY-COUNT EXISTING-IDX TOTAL-Q
    MOVE "N" TO EOF-FLAG
    OPEN INPUT ENTRY-FILE
    PERFORM UNTIL EOF-FLAG = "Y"
        READ ENTRY-FILE
            AT END MOVE "Y" TO EOF-FLAG
            NOT AT END
                IF ENTRY-LINE(1:1) NOT = "#" AND FUNCTION TRIM(ENTRY-LINE) NOT = ""
                    ADD 1 TO ENTRY-COUNT
                    MOVE SPACES TO ENTRY-CODE(ENTRY-COUNT) ENTRY-WEEK(ENTRY-COUNT) ENTRY-DAYS(ENTRY-COUNT) ENTRY-UPDATED(ENTRY-COUNT)
                    UNSTRING ENTRY-LINE DELIMITED BY "|"
                        INTO ENTRY-CODE(ENTRY-COUNT) ENTRY-WEEK(ENTRY-COUNT) ENTRY-DAYS(ENTRY-COUNT) ENTRY-UPDATED(ENTRY-COUNT)
                    END-UNSTRING
                    IF FUNCTION TRIM(ENTRY-WEEK(ENTRY-COUNT)) = FUNCTION TRIM(WEEK-START)
                        IF FUNCTION TRIM(ENTRY-CODE(ENTRY-COUNT)) = FUNCTION TRIM(PROJECT-CODE)
                            MOVE ENTRY-COUNT TO EXISTING-IDX
                        ELSE
                            COMPUTE ENTRY-Q = FUNCTION NUMVAL(ENTRY-DAYS(ENTRY-COUNT)) * 4
                            COMPUTE TOTAL-Q = TOTAL-Q + ENTRY-Q
                        END-IF
                    END-IF
                END-IF
        END-READ
    END-PERFORM
    CLOSE ENTRY-FILE.

SAVE-ENTRY.
    MOVE "N" TO CORRECTION-RECORDED
    ACCEPT TODAY-VALUE FROM DATE YYYYMMDD
    IF EXISTING-IDX > 0 AND FUNCTION TRIM(ENTRY-DAYS(EXISTING-IDX)) NOT = FUNCTION TRIM(DAYS-TEXT)
        OPEN EXTEND CORRECTION-FILE
        MOVE SPACES TO CORRECTION-LINE
        STRING FUNCTION TRIM(PROJECT-CODE) DELIMITED BY SIZE
            "|" DELIMITED BY SIZE
            FUNCTION TRIM(WEEK-START) DELIMITED BY SIZE
            "|" DELIMITED BY SIZE
            FUNCTION TRIM(ENTRY-DAYS(EXISTING-IDX)) DELIMITED BY SIZE
            "|" DELIMITED BY SIZE
            FUNCTION TRIM(DAYS-TEXT) DELIMITED BY SIZE
            "|" DELIMITED BY SIZE
            FUNCTION TRIM(TODAY-VALUE) DELIMITED BY SIZE
            INTO CORRECTION-LINE
        END-STRING
        WRITE CORRECTION-LINE
        CLOSE CORRECTION-FILE
        MOVE "Y" TO CORRECTION-RECORDED
    END-IF

    OPEN OUTPUT ENTRY-FILE
    MOVE SPACES TO ENTRY-LINE
    MOVE "# Replicobol weekly entries data" TO ENTRY-LINE
    WRITE ENTRY-LINE
    MOVE SPACES TO ENTRY-LINE
    MOVE "# Format: project_code|week_start|days|updated_at" TO ENTRY-LINE
    WRITE ENTRY-LINE
    PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > ENTRY-COUNT
        MOVE SPACES TO ENTRY-LINE
        IF IDX = EXISTING-IDX
            STRING FUNCTION TRIM(PROJECT-CODE) DELIMITED BY SIZE
                "|" DELIMITED BY SIZE
                FUNCTION TRIM(WEEK-START) DELIMITED BY SIZE
                "|" DELIMITED BY SIZE
                FUNCTION TRIM(DAYS-TEXT) DELIMITED BY SIZE
                "|" DELIMITED BY SIZE
                FUNCTION TRIM(TODAY-VALUE) DELIMITED BY SIZE
                INTO ENTRY-LINE
            END-STRING
        ELSE
            STRING FUNCTION TRIM(ENTRY-CODE(IDX)) DELIMITED BY SIZE
                "|" DELIMITED BY SIZE
                FUNCTION TRIM(ENTRY-WEEK(IDX)) DELIMITED BY SIZE
                "|" DELIMITED BY SIZE
                FUNCTION TRIM(ENTRY-DAYS(IDX)) DELIMITED BY SIZE
                "|" DELIMITED BY SIZE
                FUNCTION TRIM(ENTRY-UPDATED(IDX)) DELIMITED BY SIZE
                INTO ENTRY-LINE
            END-STRING
        END-IF
        WRITE ENTRY-LINE
    END-PERFORM
    IF EXISTING-IDX = 0
        MOVE SPACES TO ENTRY-LINE
        STRING FUNCTION TRIM(PROJECT-CODE) DELIMITED BY SIZE
            "|" DELIMITED BY SIZE
            FUNCTION TRIM(WEEK-START) DELIMITED BY SIZE
            "|" DELIMITED BY SIZE
            FUNCTION TRIM(DAYS-TEXT) DELIMITED BY SIZE
            "|" DELIMITED BY SIZE
            FUNCTION TRIM(TODAY-VALUE) DELIMITED BY SIZE
            INTO ENTRY-LINE
        END-STRING
        WRITE ENTRY-LINE
    END-IF
    CLOSE ENTRY-FILE.

SEND-SUCCESS.
    DISPLAY '{"ok":true,"data":{"entry":{"project_code":"' WITH NO ADVANCING
    DISPLAY FUNCTION TRIM(PROJECT-CODE) WITH NO ADVANCING
    DISPLAY '","week_start":"' WITH NO ADVANCING
    DISPLAY FUNCTION TRIM(WEEK-START) WITH NO ADVANCING
    DISPLAY '","days":' WITH NO ADVANCING
    DISPLAY FUNCTION TRIM(DAYS-TEXT) WITH NO ADVANCING
    DISPLAY '},"correction_recorded":' WITH NO ADVANCING
    IF CORRECTION-RECORDED = "Y"
        DISPLAY 'true' WITH NO ADVANCING
    ELSE
        DISPLAY 'false' WITH NO ADVANCING
    END-IF
    DISPLAY ',"week_total":' WITH NO ADVANCING
    COMPUTE TOTAL-WHOLE = FUNCTION INTEGER(TOTAL-Q / 4)
    COMPUTE TOTAL-REMAINDER = FUNCTION MOD(TOTAL-Q, 4)
    MOVE TOTAL-WHOLE TO TOTAL-WHOLE-TEXT
    DISPLAY FUNCTION TRIM(TOTAL-WHOLE-TEXT) WITH NO ADVANCING
    EVALUATE TOTAL-REMAINDER
        WHEN 1
            DISPLAY '.25' WITH NO ADVANCING
        WHEN 2
            DISPLAY '.5' WITH NO ADVANCING
        WHEN 3
            DISPLAY '.75' WITH NO ADVANCING
    END-EVALUATE
    DISPLAY '}}'.

SEND-METHOD-ERROR.
    DISPLAY '{"ok":false,"error":{"code":"VALIDATION_ERROR","message":"Unsupported method","field":"REQUEST_METHOD"}}'.
SEND-PROJECT-CODE-ERROR.
    DISPLAY '{"ok":false,"error":{"code":"VALIDATION_ERROR","message":"project_code is required","field":"project_code"}}'.
SEND-UNKNOWN-PROJECT-ERROR.
    DISPLAY '{"ok":false,"error":{"code":"VALIDATION_ERROR","message":"Unknown project code","field":"project_code"}}'.
SEND-WEEK-ERROR.
    DISPLAY '{"ok":false,"error":{"code":"VALIDATION_ERROR","message":"week_start must be a Monday date","field":"week_start"}}'.
SEND-DAYS-ERROR.
    DISPLAY '{"ok":false,"error":{"code":"VALIDATION_ERROR","message":"days must be numeric from 0 through 5 in 0.25 increments","field":"days"}}'.
SEND-TOTAL-ERROR.
    DISPLAY '{"ok":false,"error":{"code":"VALIDATION_ERROR","message":"Saving this value would make the weekly total exceed 5 days","field":"days"}}'.