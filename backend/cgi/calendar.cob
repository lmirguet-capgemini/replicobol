>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. calendar.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT PROJECT-FILE ASSIGN TO DYNAMIC PROJECT-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS PROJECT-STATUS.
    SELECT ENTRY-FILE ASSIGN TO DYNAMIC ENTRY-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS ENTRY-STATUS.

DATA DIVISION.
FILE SECTION.
FD PROJECT-FILE.
01 PROJECT-LINE PIC X(512).
FD ENTRY-FILE.
01 ENTRY-LINE PIC X(512).

WORKING-STORAGE SECTION.
01 PROJECT-PATH PIC X(64) VALUE "data/projects.dat".
01 ENTRY-PATH PIC X(64) VALUE "data/weekly-entries.dat".
01 PROJECT-STATUS PIC XX.
01 ENTRY-STATUS PIC XX.
01 REQUEST-METHOD PIC X(8).
01 QUERY-STRING PIC X(2048).
01 PARAM-PAIR.
   05 PARAM-PART OCCURS 8 TIMES PIC X(256).
01 IDX PIC 9(4) VALUE 1.
01 JDX PIC 9(4) VALUE 1.
01 KDX PIC 9(4) VALUE 1.
01 LDX PIC 9(4) VALUE 1.
01 EOF-FLAG PIC X VALUE "N".
01 VALID-FLAG PIC X VALUE "Y".
01 FIRST-ROW PIC X VALUE "Y".
01 FIRST-CELL PIC X VALUE "Y".
01 FOUND-ENTRY PIC X VALUE "N".
01 LATEST-FLAG PIC X VALUE "N".
01 START-WEEK PIC X(16).
01 WEEK-COUNT-TEXT PIC X(16).
01 WEEK-COUNT PIC 9(3) VALUE 12.
01 CLEAN-TEXT PIC X(32).
01 YEAR-NUM PIC 9(4) VALUE 0.
01 MONTH-NUM PIC 9(2) VALUE 0.
01 DAY-NUM PIC 9(2) VALUE 0.
01 YEAR-CALC PIC 9(4) VALUE 0.
01 MONTH-CALC PIC 9(2) VALUE 0.
01 K-VALUE PIC 9(4) VALUE 0.
01 J-VALUE PIC 9(4) VALUE 0.
01 H-VALUE PIC 9(4) VALUE 0.
01 DAYS-TO-ADD PIC 9(2) VALUE 0.
01 MONTH-DAYS PIC 9(2) VALUE 31.
01 DATE-TEXT PIC X(10).
01 YEAR-TEXT PIC 9(4).
01 MONTH-TEXT PIC 9(2).
01 DAY-TEXT PIC 9(2).
01 PROJECT-COUNT PIC 9(4) VALUE 0.
01 ENTRY-COUNT PIC 9(4) VALUE 0.
01 CELL-VALUE PIC X(32).
01 CELL-QUARTERS PIC S9(6) VALUE 0.
01 ROW-TOTAL-QUARTERS PIC S9(6) VALUE 0.
01 LIFETIME-TOTAL-QUARTERS PIC S9(6) VALUE 0.
01 PERIOD-TOTAL-QUARTERS PIC S9(6) VALUE 0.
01 OUTPUT-WHOLE PIC 9(5) VALUE 0.
01 OUTPUT-WHOLE-TEXT PIC Z(5).
01 OUTPUT-REMAINDER PIC 9 VALUE 0.
01 CURRENT-DATE-TEXT PIC 9(8).
01 CURRENT-WEEK-START PIC X(10).
01 MISSING-WINDOW-START PIC X(10).
01 MISSING-WINDOW-END PIC X(10).
01 MISSING-DECLARATIONS PIC 9(3) VALUE 0.
01 WEEKLY-TOTAL-QUARTERS PIC S9(6) VALUE 0.
01 ISO-YEAR PIC 9(4) VALUE 0.
01 ISO-MONTH PIC 9(2) VALUE 0.
01 ISO-DAY PIC 9(2) VALUE 0.
01 ISO-MONTH-CURSOR PIC 9(2) VALUE 0.
01 ISO-MONTH-DAYS PIC 9(2) VALUE 0.
01 ISO-DAY-OF-YEAR PIC 9(3) VALUE 0.
01 ISO-WEEK-NUMBER PIC 9(2) VALUE 0.
01 ISO-WEEK-TEXT PIC Z9.
01 PROJECT-TABLE.
   05 PROJECT-ROW OCCURS 500 TIMES.
      10 PROJECT-CODE PIC X(64).
      10 PROJECT-CLIENT PIC X(120).
      10 PROJECT-NAME PIC X(120).
      10 PROJECT-CREATED PIC X(32).
01 ENTRY-TABLE.
   05 ENTRY-ROW OCCURS 500 TIMES.
      10 ENTRY-CODE PIC X(64).
      10 ENTRY-WEEK PIC X(16).
      10 ENTRY-DAYS PIC X(32).
      10 ENTRY-UPDATED PIC X(32).
01 WEEK-TABLE.
   05 WEEK-ROW OCCURS 60 TIMES.
      10 WEEK-START-VALUE PIC X(10).
      10 WEEK-END-VALUE PIC X(10).
    10 WEEK-ISO-NUMBER PIC 9(2).
    10 WEEK-CURRENT-FLAG PIC X.
    10 WEEK-TOTAL-QUARTERS PIC S9(6).
    10 WEEK-TOTAL-STATUS PIC X(8).

PROCEDURE DIVISION.
MAIN-PROCEDURE.
    ACCEPT REQUEST-METHOD FROM ENVIRONMENT "REQUEST_METHOD"
    ACCEPT QUERY-STRING FROM ENVIRONMENT "QUERY_STRING"
    IF REQUEST-METHOD = SPACES
        MOVE "GET" TO REQUEST-METHOD
    END-IF

    DISPLAY "Content-Type: application/json"
    DISPLAY ""

    IF FUNCTION TRIM(REQUEST-METHOD) NOT = "GET"
        PERFORM SEND-METHOD-ERROR
        STOP RUN
    END-IF

    PERFORM PARSE-QUERY
    PERFORM VALIDATE-QUERY
    IF VALID-FLAG = "Y"
        PERFORM BUILD-WEEKS
        PERFORM LOAD-PROJECTS
        PERFORM LOAD-ENTRIES
        PERFORM CALCULATE-WEEK-METADATA
        PERFORM CALCULATE-MISSING-SUMMARY
        PERFORM SEND-CALENDAR
    END-IF
    STOP RUN.

PARSE-QUERY.
    MOVE SPACES TO START-WEEK WEEK-COUNT-TEXT PARAM-PAIR
    MOVE 12 TO WEEK-COUNT
    UNSTRING QUERY-STRING DELIMITED BY "&"
        INTO PARAM-PART(1) PARAM-PART(2) PARAM-PART(3) PARAM-PART(4)
             PARAM-PART(5) PARAM-PART(6) PARAM-PART(7) PARAM-PART(8)
    END-UNSTRING
    PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > 8
        IF PARAM-PART(IDX)(1:11) = "start_week="
            MOVE PARAM-PART(IDX)(12:) TO START-WEEK
        END-IF
        IF PARAM-PART(IDX)(1:11) = "week_count="
            MOVE PARAM-PART(IDX)(12:) TO WEEK-COUNT-TEXT
        END-IF
    END-PERFORM
    INSPECT START-WEEK REPLACING ALL "+" BY " "
    INSPECT WEEK-COUNT-TEXT REPLACING ALL "+" BY " ".

VALIDATE-QUERY.
    MOVE "Y" TO VALID-FLAG
    IF FUNCTION TRIM(WEEK-COUNT-TEXT) NOT = ""
        MOVE WEEK-COUNT-TEXT TO CLEAN-TEXT
        INSPECT CLEAN-TEXT REPLACING ALL "0" BY " "
        INSPECT CLEAN-TEXT REPLACING ALL "1" BY " "
        INSPECT CLEAN-TEXT REPLACING ALL "2" BY " "
        INSPECT CLEAN-TEXT REPLACING ALL "3" BY " "
        INSPECT CLEAN-TEXT REPLACING ALL "4" BY " "
        INSPECT CLEAN-TEXT REPLACING ALL "5" BY " "
        INSPECT CLEAN-TEXT REPLACING ALL "6" BY " "
        INSPECT CLEAN-TEXT REPLACING ALL "7" BY " "
        INSPECT CLEAN-TEXT REPLACING ALL "8" BY " "
        INSPECT CLEAN-TEXT REPLACING ALL "9" BY " "
        IF FUNCTION TRIM(CLEAN-TEXT) NOT = ""
            MOVE "N" TO VALID-FLAG
            PERFORM SEND-WEEK-COUNT-ERROR
            EXIT PARAGRAPH
        END-IF
        COMPUTE WEEK-COUNT = FUNCTION NUMVAL(WEEK-COUNT-TEXT)
    END-IF
    IF WEEK-COUNT < 1 OR WEEK-COUNT > 52
        MOVE "N" TO VALID-FLAG
        PERFORM SEND-WEEK-COUNT-ERROR
        EXIT PARAGRAPH
    END-IF
    IF FUNCTION TRIM(START-WEEK) = ""
        PERFORM CALCULATE-CURRENT-WEEK
        MOVE 70 TO DAYS-TO-ADD
        PERFORM SUBTRACT-DAYS
        PERFORM FORMAT-DATE
        MOVE DATE-TEXT TO START-WEEK
        MOVE 12 TO WEEK-COUNT
    END-IF
    PERFORM VALIDATE-WEEK.

VALIDATE-WEEK.
    IF FUNCTION LENGTH(FUNCTION TRIM(START-WEEK)) NOT = 10
        MOVE "N" TO VALID-FLAG
        PERFORM SEND-WEEK-ERROR
        EXIT PARAGRAPH
    END-IF
    IF START-WEEK(5:1) NOT = "-" OR START-WEEK(8:1) NOT = "-"
        MOVE "N" TO VALID-FLAG
        PERFORM SEND-WEEK-ERROR
        EXIT PARAGRAPH
    END-IF
    MOVE START-WEEK TO CLEAN-TEXT
    INSPECT CLEAN-TEXT REPLACING ALL "0" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "1" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "2" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "3" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "4" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "5" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "6" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "7" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "8" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "9" BY " "
    INSPECT CLEAN-TEXT REPLACING ALL "-" BY " "
    IF FUNCTION TRIM(CLEAN-TEXT) NOT = ""
        MOVE "N" TO VALID-FLAG
        PERFORM SEND-WEEK-ERROR
        EXIT PARAGRAPH
    END-IF
    COMPUTE YEAR-NUM = FUNCTION NUMVAL(START-WEEK(1:4))
    COMPUTE MONTH-NUM = FUNCTION NUMVAL(START-WEEK(6:2))
    COMPUTE DAY-NUM = FUNCTION NUMVAL(START-WEEK(9:2))
    IF MONTH-NUM < 1 OR MONTH-NUM > 12 OR DAY-NUM < 1 OR DAY-NUM > 31
        MOVE "N" TO VALID-FLAG
        PERFORM SEND-WEEK-ERROR
        EXIT PARAGRAPH
    END-IF
    IF MONTH-NUM < 3
        COMPUTE MONTH-CALC = MONTH-NUM + 12
        COMPUTE YEAR-CALC = YEAR-NUM - 1
    ELSE
        MOVE MONTH-NUM TO MONTH-CALC
        MOVE YEAR-NUM TO YEAR-CALC
    END-IF
    COMPUTE K-VALUE = FUNCTION MOD(YEAR-CALC, 100)
    COMPUTE J-VALUE = FUNCTION INTEGER(YEAR-CALC / 100)
    COMPUTE H-VALUE = FUNCTION MOD(DAY-NUM + FUNCTION INTEGER((13 * (MONTH-CALC + 1)) / 5) + K-VALUE + FUNCTION INTEGER(K-VALUE / 4) + FUNCTION INTEGER(J-VALUE / 4) + (5 * J-VALUE), 7)
    IF H-VALUE NOT = 2
        MOVE "N" TO VALID-FLAG
        PERFORM SEND-WEEK-ERROR
    END-IF.

BUILD-WEEKS.
    COMPUTE YEAR-NUM = FUNCTION NUMVAL(START-WEEK(1:4))
    COMPUTE MONTH-NUM = FUNCTION NUMVAL(START-WEEK(6:2))
    COMPUTE DAY-NUM = FUNCTION NUMVAL(START-WEEK(9:2))
    PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > WEEK-COUNT
        PERFORM FORMAT-DATE
        MOVE DATE-TEXT TO WEEK-START-VALUE(IDX)
        MOVE 4 TO DAYS-TO-ADD
        PERFORM ADD-DAYS
        PERFORM FORMAT-DATE
        MOVE DATE-TEXT TO WEEK-END-VALUE(IDX)
        MOVE 3 TO DAYS-TO-ADD
        PERFORM ADD-DAYS
    END-PERFORM.

FORMAT-DATE.
    MOVE SPACES TO DATE-TEXT
    MOVE YEAR-NUM TO YEAR-TEXT
    MOVE MONTH-NUM TO MONTH-TEXT
    MOVE DAY-NUM TO DAY-TEXT
    STRING YEAR-TEXT DELIMITED BY SIZE
        "-" DELIMITED BY SIZE
        MONTH-TEXT DELIMITED BY SIZE
        "-" DELIMITED BY SIZE
        DAY-TEXT DELIMITED BY SIZE
        INTO DATE-TEXT
    END-STRING.

ADD-DAYS.
    ADD DAYS-TO-ADD TO DAY-NUM
    PERFORM NORMALIZE-DATE UNTIL DAY-NUM <= MONTH-DAYS.

NORMALIZE-DATE.
    PERFORM SET-MONTH-DAYS
    IF DAY-NUM > MONTH-DAYS
        SUBTRACT MONTH-DAYS FROM DAY-NUM
        ADD 1 TO MONTH-NUM
        IF MONTH-NUM > 12
            MOVE 1 TO MONTH-NUM
            ADD 1 TO YEAR-NUM
        END-IF
        PERFORM SET-MONTH-DAYS
    END-IF.

SET-MONTH-DAYS.
    EVALUATE MONTH-NUM
        WHEN 1 WHEN 3 WHEN 5 WHEN 7 WHEN 8 WHEN 10 WHEN 12
            MOVE 31 TO MONTH-DAYS
        WHEN 4 WHEN 6 WHEN 9 WHEN 11
            MOVE 30 TO MONTH-DAYS
        WHEN OTHER
            IF FUNCTION MOD(YEAR-NUM, 400) = 0 OR (FUNCTION MOD(YEAR-NUM, 4) = 0 AND FUNCTION MOD(YEAR-NUM, 100) NOT = 0)
                MOVE 29 TO MONTH-DAYS
            ELSE
                MOVE 28 TO MONTH-DAYS
            END-IF
    END-EVALUATE.

CALCULATE-CURRENT-WEEK.
    ACCEPT CURRENT-DATE-TEXT FROM DATE YYYYMMDD
    COMPUTE YEAR-NUM = FUNCTION NUMVAL(CURRENT-DATE-TEXT(1:4))
    COMPUTE MONTH-NUM = FUNCTION NUMVAL(CURRENT-DATE-TEXT(5:2))
    COMPUTE DAY-NUM = FUNCTION NUMVAL(CURRENT-DATE-TEXT(7:2))
    PERFORM CALCULATE-WEEKDAY
    COMPUTE DAYS-TO-ADD = FUNCTION MOD(H-VALUE + 5, 7)
    PERFORM SUBTRACT-DAYS
    PERFORM FORMAT-DATE
    MOVE DATE-TEXT TO CURRENT-WEEK-START.

CALCULATE-WEEK-METADATA.
    PERFORM CALCULATE-CURRENT-WEEK
    PERFORM VARYING JDX FROM 1 BY 1 UNTIL JDX > WEEK-COUNT
        PERFORM CALCULATE-ISO-WEEK
        MOVE ISO-WEEK-NUMBER TO WEEK-ISO-NUMBER(JDX)
        IF WEEK-START-VALUE(JDX) = CURRENT-WEEK-START
            MOVE "Y" TO WEEK-CURRENT-FLAG(JDX)
        ELSE
            MOVE "N" TO WEEK-CURRENT-FLAG(JDX)
        END-IF
        MOVE 0 TO WEEK-TOTAL-QUARTERS(JDX)
        PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > PROJECT-COUNT
            PERFORM FIND-CELL
            IF FOUND-ENTRY = "Y"
                COMPUTE CELL-QUARTERS = FUNCTION NUMVAL(CELL-VALUE) * 4
                ADD CELL-QUARTERS TO WEEK-TOTAL-QUARTERS(JDX)
            END-IF
        END-PERFORM
        IF WEEK-TOTAL-QUARTERS(JDX) = 20
            MOVE "complete" TO WEEK-TOTAL-STATUS(JDX)
        ELSE
            IF WEEK-START-VALUE(JDX) < CURRENT-WEEK-START AND WEEK-TOTAL-QUARTERS(JDX) < 20
                MOVE "overdue" TO WEEK-TOTAL-STATUS(JDX)
            ELSE
                MOVE "default" TO WEEK-TOTAL-STATUS(JDX)
            END-IF
        END-IF
    END-PERFORM.

CALCULATE-ISO-WEEK.
    COMPUTE ISO-YEAR = FUNCTION NUMVAL(WEEK-START-VALUE(JDX)(1:4))
    COMPUTE ISO-MONTH = FUNCTION NUMVAL(WEEK-START-VALUE(JDX)(6:2))
    COMPUTE ISO-DAY = FUNCTION NUMVAL(WEEK-START-VALUE(JDX)(9:2))
    ADD 3 TO ISO-DAY
    MOVE ISO-MONTH TO ISO-MONTH-CURSOR
    PERFORM SET-ISO-MONTH-DAYS
    PERFORM NORMALIZE-ISO-DATE UNTIL ISO-DAY <= ISO-MONTH-DAYS
    MOVE 0 TO ISO-DAY-OF-YEAR
    PERFORM VARYING ISO-MONTH-CURSOR FROM 1 BY 1 UNTIL ISO-MONTH-CURSOR >= ISO-MONTH
        PERFORM SET-ISO-MONTH-DAYS
        ADD ISO-MONTH-DAYS TO ISO-DAY-OF-YEAR
    END-PERFORM
    ADD ISO-DAY TO ISO-DAY-OF-YEAR
    COMPUTE ISO-WEEK-NUMBER = FUNCTION INTEGER((ISO-DAY-OF-YEAR - 1) / 7) + 1.

NORMALIZE-ISO-DATE.
    MOVE ISO-MONTH TO ISO-MONTH-CURSOR
    PERFORM SET-ISO-MONTH-DAYS
    IF ISO-DAY > ISO-MONTH-DAYS
        SUBTRACT ISO-MONTH-DAYS FROM ISO-DAY
        ADD 1 TO ISO-MONTH
        IF ISO-MONTH > 12
            MOVE 1 TO ISO-MONTH
            ADD 1 TO ISO-YEAR
        END-IF
        MOVE ISO-MONTH TO ISO-MONTH-CURSOR
        PERFORM SET-ISO-MONTH-DAYS
    END-IF.

SET-ISO-MONTH-DAYS.
    EVALUATE ISO-MONTH-CURSOR
        WHEN 1 WHEN 3 WHEN 5 WHEN 7 WHEN 8 WHEN 10 WHEN 12
            MOVE 31 TO ISO-MONTH-DAYS
        WHEN 4 WHEN 6 WHEN 9 WHEN 11
            MOVE 30 TO ISO-MONTH-DAYS
        WHEN OTHER
            IF FUNCTION MOD(ISO-YEAR, 400) = 0 OR (FUNCTION MOD(ISO-YEAR, 4) = 0 AND FUNCTION MOD(ISO-YEAR, 100) NOT = 0)
                MOVE 29 TO ISO-MONTH-DAYS
            ELSE
                MOVE 28 TO ISO-MONTH-DAYS
            END-IF
    END-EVALUATE.

LOAD-PROJECTS.
    MOVE 0 TO PROJECT-COUNT
    MOVE "N" TO EOF-FLAG
    OPEN INPUT PROJECT-FILE
    PERFORM UNTIL EOF-FLAG = "Y"
        READ PROJECT-FILE
            AT END MOVE "Y" TO EOF-FLAG
            NOT AT END
                IF PROJECT-LINE(1:1) NOT = "#" AND FUNCTION TRIM(PROJECT-LINE) NOT = ""
                    ADD 1 TO PROJECT-COUNT
                    MOVE SPACES TO PROJECT-CODE(PROJECT-COUNT) PROJECT-CLIENT(PROJECT-COUNT) PROJECT-NAME(PROJECT-COUNT) PROJECT-CREATED(PROJECT-COUNT)
                    UNSTRING PROJECT-LINE DELIMITED BY "|"
                        INTO PROJECT-CODE(PROJECT-COUNT) PROJECT-CLIENT(PROJECT-COUNT) PROJECT-NAME(PROJECT-COUNT) PROJECT-CREATED(PROJECT-COUNT)
                    END-UNSTRING
                END-IF
        END-READ
    END-PERFORM
    CLOSE PROJECT-FILE.

LOAD-ENTRIES.
    MOVE 0 TO ENTRY-COUNT
    MOVE "N" TO EOF-FLAG
    OPEN INPUT ENTRY-FILE
    PERFORM UNTIL EOF-FLAG = "Y"
        READ ENTRY-FILE
            AT END MOVE "Y" TO EOF-FLAG
            NOT AT END
                IF ENTRY-LINE(1:1) NOT = "#" AND FUNCTION TRIM(ENTRY-LINE) NOT = ""
                    ADD 1 TO ENTRY-COUNT
                    MOVE SPACES TO ENTRY-CODE(ENTRY-COUNT) ENTRY-WEEK(ENTRY-COUNT) ENTRY-DAYS(ENTRY-COUNT) ENTRY-UPDATED(ENTRY-COUNT)
                    UNSTRING ENTRY-LINE DELIMITED BY "|"
                        INTO ENTRY-CODE(ENTRY-COUNT) ENTRY-WEEK(ENTRY-COUNT) ENTRY-DAYS(ENTRY-COUNT) ENTRY-UPDATED(ENTRY-COUNT)
                    END-UNSTRING
                END-IF
        END-READ
    END-PERFORM
    CLOSE ENTRY-FILE.

CALCULATE-MISSING-SUMMARY.
    PERFORM CALCULATE-CURRENT-WEEK
    MOVE CURRENT-WEEK-START TO MISSING-WINDOW-END
    SUBTRACT 3 FROM MONTH-NUM
    PERFORM UNTIL MONTH-NUM > 0
        ADD 12 TO MONTH-NUM
        SUBTRACT 1 FROM YEAR-NUM
    END-PERFORM
    PERFORM SET-MONTH-DAYS
    IF DAY-NUM > MONTH-DAYS
        MOVE MONTH-DAYS TO DAY-NUM
    END-IF
    PERFORM CALCULATE-WEEKDAY
    COMPUTE DAYS-TO-ADD = FUNCTION MOD(9 - H-VALUE, 7)
    PERFORM ADD-DAYS
    PERFORM FORMAT-DATE
    MOVE DATE-TEXT TO MISSING-WINDOW-START
    MOVE 0 TO MISSING-DECLARATIONS
    PERFORM UNTIL DATE-TEXT > MISSING-WINDOW-END
        MOVE 0 TO WEEKLY-TOTAL-QUARTERS
        PERFORM VARYING KDX FROM 1 BY 1 UNTIL KDX > ENTRY-COUNT
            IF FUNCTION TRIM(ENTRY-WEEK(KDX)) = DATE-TEXT
                COMPUTE CELL-QUARTERS = FUNCTION NUMVAL(ENTRY-DAYS(KDX)) * 4
                ADD CELL-QUARTERS TO WEEKLY-TOTAL-QUARTERS
            END-IF
        END-PERFORM
        IF WEEKLY-TOTAL-QUARTERS < 20
            ADD 1 TO MISSING-DECLARATIONS
        END-IF
        MOVE 7 TO DAYS-TO-ADD
        PERFORM ADD-DAYS
        PERFORM FORMAT-DATE
    END-PERFORM.

CALCULATE-WEEKDAY.
    IF MONTH-NUM < 3
        COMPUTE MONTH-CALC = MONTH-NUM + 12
        COMPUTE YEAR-CALC = YEAR-NUM - 1
    ELSE
        MOVE MONTH-NUM TO MONTH-CALC
        MOVE YEAR-NUM TO YEAR-CALC
    END-IF
    COMPUTE K-VALUE = FUNCTION MOD(YEAR-CALC, 100)
    COMPUTE J-VALUE = FUNCTION INTEGER(YEAR-CALC / 100)
    COMPUTE H-VALUE = FUNCTION MOD(DAY-NUM + FUNCTION INTEGER((13 * (MONTH-CALC + 1)) / 5) + K-VALUE + FUNCTION INTEGER(K-VALUE / 4) + FUNCTION INTEGER(J-VALUE / 4) + (5 * J-VALUE), 7).

SUBTRACT-DAYS.
    PERFORM VARYING KDX FROM 1 BY 1 UNTIL KDX > DAYS-TO-ADD
        SUBTRACT 1 FROM DAY-NUM
        IF DAY-NUM = 0
            SUBTRACT 1 FROM MONTH-NUM
            IF MONTH-NUM = 0
                MOVE 12 TO MONTH-NUM
                SUBTRACT 1 FROM YEAR-NUM
            END-IF
            PERFORM SET-MONTH-DAYS
            MOVE MONTH-DAYS TO DAY-NUM
        END-IF
    END-PERFORM.

SEND-CALENDAR.
    DISPLAY '{"ok":true,"data":{"weeks":[' WITH NO ADVANCING
    PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > WEEK-COUNT
        IF IDX > 1 DISPLAY ',' WITH NO ADVANCING END-IF
        DISPLAY '{"week_start":"' WITH NO ADVANCING
        DISPLAY WEEK-START-VALUE(IDX) WITH NO ADVANCING
        DISPLAY '","week_end":"' WITH NO ADVANCING
        DISPLAY WEEK-END-VALUE(IDX) WITH NO ADVANCING
        DISPLAY '","label":"' WITH NO ADVANCING
        DISPLAY WEEK-START-VALUE(IDX) WITH NO ADVANCING
        DISPLAY ' to ' WITH NO ADVANCING
        DISPLAY WEEK-END-VALUE(IDX) WITH NO ADVANCING
        DISPLAY '","iso_week_number":' WITH NO ADVANCING
        MOVE WEEK-ISO-NUMBER(IDX) TO ISO-WEEK-TEXT
        DISPLAY FUNCTION TRIM(ISO-WEEK-TEXT) WITH NO ADVANCING
        DISPLAY ',"is_current_week":' WITH NO ADVANCING
        IF WEEK-CURRENT-FLAG(IDX) = "Y"
            DISPLAY 'true' WITH NO ADVANCING
        ELSE
            DISPLAY 'false' WITH NO ADVANCING
        END-IF
        DISPLAY ',"period_total_days":' WITH NO ADVANCING
        MOVE WEEK-TOTAL-QUARTERS(IDX) TO CELL-QUARTERS
        PERFORM DISPLAY-QUARTERS
        DISPLAY ',"period_total_status":"' WITH NO ADVANCING
        DISPLAY FUNCTION TRIM(WEEK-TOTAL-STATUS(IDX)) WITH NO ADVANCING
        DISPLAY '"}' WITH NO ADVANCING
    END-PERFORM
    DISPLAY '],"rows":[' WITH NO ADVANCING
    MOVE "Y" TO FIRST-ROW
    MOVE 0 TO PERIOD-TOTAL-QUARTERS
    PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > PROJECT-COUNT
        IF FIRST-ROW = "N" DISPLAY ',' WITH NO ADVANCING END-IF
        MOVE "N" TO FIRST-ROW
        PERFORM SEND-PROJECT-ROW
    END-PERFORM
    DISPLAY '],"period_total_days":' WITH NO ADVANCING
    MOVE PERIOD-TOTAL-QUARTERS TO CELL-QUARTERS
    PERFORM DISPLAY-QUARTERS
    DISPLAY ',"summary":{"declared_days":' WITH NO ADVANCING
    MOVE PERIOD-TOTAL-QUARTERS TO CELL-QUARTERS
    PERFORM DISPLAY-QUARTERS
    DISPLAY ',"active_projects":' WITH NO ADVANCING
    COMPUTE CELL-QUARTERS = PROJECT-COUNT * 4
    PERFORM DISPLAY-QUARTERS
    DISPLAY ',"missing_declarations":' WITH NO ADVANCING
    COMPUTE CELL-QUARTERS = MISSING-DECLARATIONS * 4
    PERFORM DISPLAY-QUARTERS
    DISPLAY ',"missing_window_start":"' WITH NO ADVANCING
    DISPLAY MISSING-WINDOW-START WITH NO ADVANCING
    DISPLAY '","missing_window_end":"' WITH NO ADVANCING
    DISPLAY MISSING-WINDOW-END WITH NO ADVANCING
    DISPLAY '"}}}'.

SEND-PROJECT-ROW.
    DISPLAY '{"project":{"client_name":"' WITH NO ADVANCING
    DISPLAY FUNCTION TRIM(PROJECT-CLIENT(IDX)) WITH NO ADVANCING
    DISPLAY '","project_name":"' WITH NO ADVANCING
    DISPLAY FUNCTION TRIM(PROJECT-NAME(IDX)) WITH NO ADVANCING
    DISPLAY '","project_code":"' WITH NO ADVANCING
    DISPLAY FUNCTION TRIM(PROJECT-CODE(IDX)) WITH NO ADVANCING
    DISPLAY '"},"cells":[' WITH NO ADVANCING
    MOVE "Y" TO FIRST-CELL
    MOVE 0 TO ROW-TOTAL-QUARTERS
    PERFORM CALCULATE-LIFETIME-TOTAL
    PERFORM VARYING JDX FROM 1 BY 1 UNTIL JDX > WEEK-COUNT
        IF FIRST-CELL = "N" DISPLAY ',' WITH NO ADVANCING END-IF
        MOVE "N" TO FIRST-CELL
        PERFORM FIND-CELL
        IF FOUND-ENTRY = "Y"
            COMPUTE CELL-QUARTERS = FUNCTION NUMVAL(CELL-VALUE) * 4
            ADD CELL-QUARTERS TO ROW-TOTAL-QUARTERS
            DISPLAY '{"week_start":"' WITH NO ADVANCING
            DISPLAY WEEK-START-VALUE(JDX) WITH NO ADVANCING
            DISPLAY '","display_value":' WITH NO ADVANCING
            DISPLAY FUNCTION TRIM(CELL-VALUE) WITH NO ADVANCING
            DISPLAY ',"status":"saved"}' WITH NO ADVANCING
        ELSE
            DISPLAY '{"week_start":"' WITH NO ADVANCING
            DISPLAY WEEK-START-VALUE(JDX) WITH NO ADVANCING
            DISPLAY '","display_value":"","status":"blank"}' WITH NO ADVANCING
        END-IF
    END-PERFORM
    DISPLAY '],"total_days":' WITH NO ADVANCING
    MOVE ROW-TOTAL-QUARTERS TO CELL-QUARTERS
    PERFORM DISPLAY-QUARTERS
    DISPLAY ',"lifetime_total_days":' WITH NO ADVANCING
    MOVE LIFETIME-TOTAL-QUARTERS TO CELL-QUARTERS
    PERFORM DISPLAY-QUARTERS
    ADD ROW-TOTAL-QUARTERS TO PERIOD-TOTAL-QUARTERS
    DISPLAY '}' WITH NO ADVANCING.

CALCULATE-LIFETIME-TOTAL.
    MOVE 0 TO LIFETIME-TOTAL-QUARTERS
    PERFORM VARYING KDX FROM 1 BY 1 UNTIL KDX > ENTRY-COUNT
        IF FUNCTION TRIM(ENTRY-CODE(KDX)) = FUNCTION TRIM(PROJECT-CODE(IDX))
            MOVE "Y" TO LATEST-FLAG
            MOVE KDX TO LDX
            ADD 1 TO LDX
            PERFORM UNTIL LDX > ENTRY-COUNT
                IF FUNCTION TRIM(ENTRY-CODE(LDX)) = FUNCTION TRIM(ENTRY-CODE(KDX)) AND FUNCTION TRIM(ENTRY-WEEK(LDX)) = FUNCTION TRIM(ENTRY-WEEK(KDX))
                    MOVE "N" TO LATEST-FLAG
                END-IF
                ADD 1 TO LDX
            END-PERFORM
            IF LATEST-FLAG = "Y"
                COMPUTE CELL-QUARTERS = FUNCTION NUMVAL(ENTRY-DAYS(KDX)) * 4
                ADD CELL-QUARTERS TO LIFETIME-TOTAL-QUARTERS
            END-IF
        END-IF
    END-PERFORM.

DISPLAY-QUARTERS.
    COMPUTE OUTPUT-WHOLE = FUNCTION INTEGER(CELL-QUARTERS / 4)
    COMPUTE OUTPUT-REMAINDER = FUNCTION MOD(CELL-QUARTERS, 4)
    MOVE OUTPUT-WHOLE TO OUTPUT-WHOLE-TEXT
    IF OUTPUT-WHOLE = 0
        DISPLAY '0' WITH NO ADVANCING
    ELSE
        DISPLAY FUNCTION TRIM(OUTPUT-WHOLE-TEXT) WITH NO ADVANCING
    END-IF
    EVALUATE OUTPUT-REMAINDER
        WHEN 1
            DISPLAY '.25' WITH NO ADVANCING
        WHEN 2
            DISPLAY '.5' WITH NO ADVANCING
        WHEN 3
            DISPLAY '.75' WITH NO ADVANCING
    END-EVALUATE.

FIND-CELL.
    MOVE "N" TO FOUND-ENTRY
    MOVE SPACES TO CELL-VALUE
    PERFORM VARYING KDX FROM 1 BY 1 UNTIL KDX > ENTRY-COUNT
        IF FUNCTION TRIM(ENTRY-CODE(KDX)) = FUNCTION TRIM(PROJECT-CODE(IDX)) AND FUNCTION TRIM(ENTRY-WEEK(KDX)) = FUNCTION TRIM(WEEK-START-VALUE(JDX))
            MOVE ENTRY-DAYS(KDX) TO CELL-VALUE
            MOVE "Y" TO FOUND-ENTRY
        END-IF
    END-PERFORM.

SEND-METHOD-ERROR.
    DISPLAY '{"ok":false,"error":{"code":"VALIDATION_ERROR","message":"Unsupported method","field":"REQUEST_METHOD"}}'.
SEND-WEEK-ERROR.
    DISPLAY '{"ok":false,"error":{"code":"VALIDATION_ERROR","message":"start_week must be a Monday date","field":"start_week"}}'.
SEND-WEEK-COUNT-ERROR.
    DISPLAY '{"ok":false,"error":{"code":"VALIDATION_ERROR","message":"week_count must be a positive integer","field":"week_count"}}'.