>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. projects.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT PROJECT-FILE ASSIGN TO DYNAMIC PROJECT-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS PROJECT-STATUS.

DATA DIVISION.
FILE SECTION.
FD PROJECT-FILE.
01 PROJECT-LINE PIC X(512).

WORKING-STORAGE SECTION.
01 PROJECT-PATH PIC X(64) VALUE "data/projects.dat".
01 PROJECT-STATUS PIC XX.
01 REQUEST-METHOD PIC X(8).
01 FORM-DATA PIC X(2048).
01 PARAM-PAIR.
   05 PARAM-PART OCCURS 8 TIMES PIC X(256).
01 IDX PIC 9 VALUE 1.
01 EOF-FLAG PIC X VALUE "N".
01 FIRST-ROW PIC X VALUE "Y".
01 DUPLICATE-FLAG PIC X VALUE "N".
01 CLIENT-NAME PIC X(120).
01 PROJECT-NAME PIC X(120).
01 PROJECT-CODE PIC X(64).
01 ROW-CODE PIC X(64).
01 ROW-CLIENT PIC X(120).
01 ROW-NAME PIC X(120).
01 ROW-CREATED PIC X(32).
01 CURRENT-DATE-FIELDS.
   05 CURRENT-DATE-VALUE PIC X(21).

PROCEDURE DIVISION.
MAIN-PROCEDURE.
    ACCEPT REQUEST-METHOD FROM ENVIRONMENT "REQUEST_METHOD"
    IF REQUEST-METHOD = SPACES
        MOVE "GET" TO REQUEST-METHOD
    END-IF

    DISPLAY "Content-Type: application/json"
    DISPLAY ""

    EVALUATE FUNCTION TRIM(REQUEST-METHOD)
        WHEN "POST"
            PERFORM HANDLE-CREATE
        WHEN "GET"
            PERFORM HANDLE-LIST
        WHEN OTHER
            PERFORM SEND-METHOD-ERROR
    END-EVALUATE
    STOP RUN.

HANDLE-CREATE.
    ACCEPT FORM-DATA
    PERFORM PARSE-FORM

    IF FUNCTION TRIM(CLIENT-NAME) = ""
        PERFORM SEND-CLIENT-ERROR
        EXIT PARAGRAPH
    END-IF
    IF FUNCTION TRIM(PROJECT-NAME) = ""
        PERFORM SEND-PROJECT-ERROR
        EXIT PARAGRAPH
    END-IF
    IF FUNCTION TRIM(PROJECT-CODE) = ""
        PERFORM SEND-CODE-ERROR
        EXIT PARAGRAPH
    END-IF

    PERFORM CHECK-DUPLICATE
    IF DUPLICATE-FLAG = "Y"
        PERFORM SEND-DUPLICATE-ERROR
        EXIT PARAGRAPH
    END-IF

    ACCEPT CURRENT-DATE-VALUE FROM DATE YYYYMMDD
    OPEN EXTEND PROJECT-FILE
    MOVE SPACES TO PROJECT-LINE
    STRING FUNCTION TRIM(PROJECT-CODE) DELIMITED BY SIZE
        "|" DELIMITED BY SIZE
        FUNCTION TRIM(CLIENT-NAME) DELIMITED BY SIZE
        "|" DELIMITED BY SIZE
        FUNCTION TRIM(PROJECT-NAME) DELIMITED BY SIZE
        "|" DELIMITED BY SIZE
        FUNCTION TRIM(CURRENT-DATE-VALUE) DELIMITED BY SIZE
        INTO PROJECT-LINE
    END-STRING
    WRITE PROJECT-LINE
    CLOSE PROJECT-FILE

    DISPLAY '{"ok":true,"data":{"project":{"client_name":"' WITH NO ADVANCING
    DISPLAY FUNCTION TRIM(CLIENT-NAME) WITH NO ADVANCING
    DISPLAY '","project_name":"' WITH NO ADVANCING
    DISPLAY FUNCTION TRIM(PROJECT-NAME) WITH NO ADVANCING
    DISPLAY '","project_code":"' WITH NO ADVANCING
    DISPLAY FUNCTION TRIM(PROJECT-CODE) WITH NO ADVANCING
    DISPLAY '"}}}'.

HANDLE-LIST.
    DISPLAY '{"ok":true,"data":{"projects":[' WITH NO ADVANCING
    MOVE "Y" TO FIRST-ROW
    MOVE "N" TO EOF-FLAG
    OPEN INPUT PROJECT-FILE
    PERFORM UNTIL EOF-FLAG = "Y"
        READ PROJECT-FILE
            AT END MOVE "Y" TO EOF-FLAG
            NOT AT END
                IF PROJECT-LINE(1:1) NOT = "#" AND FUNCTION TRIM(PROJECT-LINE) NOT = ""
                    PERFORM EMIT-PROJECT-ROW
                END-IF
        END-READ
    END-PERFORM
    CLOSE PROJECT-FILE
    DISPLAY ']}}'.

EMIT-PROJECT-ROW.
    MOVE SPACES TO ROW-CODE ROW-CLIENT ROW-NAME ROW-CREATED
    UNSTRING PROJECT-LINE DELIMITED BY "|"
        INTO ROW-CODE ROW-CLIENT ROW-NAME ROW-CREATED
    END-UNSTRING
    IF FIRST-ROW = "N"
        DISPLAY ',' WITH NO ADVANCING
    END-IF
    MOVE "N" TO FIRST-ROW
    DISPLAY '{"client_name":"' WITH NO ADVANCING
    DISPLAY FUNCTION TRIM(ROW-CLIENT) WITH NO ADVANCING
    DISPLAY '","project_name":"' WITH NO ADVANCING
    DISPLAY FUNCTION TRIM(ROW-NAME) WITH NO ADVANCING
    DISPLAY '","project_code":"' WITH NO ADVANCING
    DISPLAY FUNCTION TRIM(ROW-CODE) WITH NO ADVANCING
    DISPLAY '"}' WITH NO ADVANCING.

PARSE-FORM.
    MOVE SPACES TO CLIENT-NAME PROJECT-NAME PROJECT-CODE
    MOVE SPACES TO PARAM-PAIR
    UNSTRING FORM-DATA DELIMITED BY "&"
        INTO PARAM-PART(1) PARAM-PART(2) PARAM-PART(3) PARAM-PART(4)
             PARAM-PART(5) PARAM-PART(6) PARAM-PART(7) PARAM-PART(8)
    END-UNSTRING
    PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > 8
        IF PARAM-PART(IDX)(1:12) = "client_name="
            MOVE PARAM-PART(IDX)(13:) TO CLIENT-NAME
        END-IF
        IF PARAM-PART(IDX)(1:13) = "project_name="
            MOVE PARAM-PART(IDX)(14:) TO PROJECT-NAME
        END-IF
        IF PARAM-PART(IDX)(1:13) = "project_code="
            MOVE PARAM-PART(IDX)(14:) TO PROJECT-CODE
        END-IF
    END-PERFORM
    INSPECT CLIENT-NAME REPLACING ALL "+" BY " "
    INSPECT PROJECT-NAME REPLACING ALL "+" BY " "
    INSPECT PROJECT-CODE REPLACING ALL "+" BY " ".

CHECK-DUPLICATE.
    MOVE "N" TO DUPLICATE-FLAG EOF-FLAG
    OPEN INPUT PROJECT-FILE
    PERFORM UNTIL EOF-FLAG = "Y"
        READ PROJECT-FILE
            AT END MOVE "Y" TO EOF-FLAG
            NOT AT END
                IF PROJECT-LINE(1:1) NOT = "#"
                    MOVE SPACES TO ROW-CODE ROW-CLIENT ROW-NAME ROW-CREATED
                    UNSTRING PROJECT-LINE DELIMITED BY "|"
                        INTO ROW-CODE ROW-CLIENT ROW-NAME ROW-CREATED
                    END-UNSTRING
                    IF FUNCTION TRIM(ROW-CODE) = FUNCTION TRIM(PROJECT-CODE)
                        MOVE "Y" TO DUPLICATE-FLAG EOF-FLAG
                    END-IF
                END-IF
        END-READ
    END-PERFORM
    CLOSE PROJECT-FILE.

SEND-CLIENT-ERROR.
    DISPLAY '{"ok":false,"error":{"code":"VALIDATION_ERROR","message":"client_name is required","field":"client_name"}}'.

SEND-PROJECT-ERROR.
    DISPLAY '{"ok":false,"error":{"code":"VALIDATION_ERROR","message":"project_name is required","field":"project_name"}}'.

SEND-CODE-ERROR.
    DISPLAY '{"ok":false,"error":{"code":"VALIDATION_ERROR","message":"project_code is required","field":"project_code"}}'.

SEND-DUPLICATE-ERROR.
    DISPLAY '{"ok":false,"error":{"code":"VALIDATION_ERROR","message":"Duplicate project code","field":"project_code"}}'.

SEND-METHOD-ERROR.
    DISPLAY '{"ok":false,"error":{"code":"VALIDATION_ERROR","message":"Unsupported method","field":"REQUEST_METHOD"}}'.